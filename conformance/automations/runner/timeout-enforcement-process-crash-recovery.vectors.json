{
  "schemaVersion": "coven.automations.timeout-enforcement-process-crash-recovery-vectors.v1",
  "cases": [
    {
      "caseId": "timeout-killed-inside-fence",
      "boundary": "after_fence_insert",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-timeout-crash",
        "name": "Conformance timeout crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 1,
        "runtime": "coven-code",
        "prompt": "Run the native timeout crash conformance probe.",
        "cwd": "/work/project"
      },
      "expected": {
        "initialOutcome": "terminated",
        "runAfterExit": "running",
        "workerStops": 0,
        "runAfterRestart": "timed_out",
        "restartIsNoop": false,
        "runAfterPass": "timed_out",
        "runAfterSettle": "timed_out",
        "laterStops": 0,
        "launches": 0,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
