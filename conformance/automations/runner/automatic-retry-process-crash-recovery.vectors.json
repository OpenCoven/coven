{
  "schemaVersion": "coven.automations.automatic-retry-process-crash-recovery-vectors.v1",
  "cases": [
    {
      "caseId": "retry-killed-after-rejected-session",
      "boundary": "after_rejected_session",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-auto-retry-crash",
        "name": "Conformance automatic retry crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 30,
        "runtime": "coven-code",
        "prompt": "Run the native automatic retry crash conformance probe.",
        "cwd": "/work/project",
        "retry": {
          "maxAttempts": 2,
          "backoffPolicy": "fixed",
          "backoffSeconds": 60,
          "retryableClasses": [
            "runtime_unavailable"
          ]
        }
      },
      "expected": {
        "initialOutcome": "terminated",
        "retryAfterExit": "launching",
        "retryAfterRestart": "held",
        "restartIsNoop": false,
        "restartLaunches": 0,
        "retryAfterPass": "held",
        "passIsNoop": true,
        "launches": 0,
        "stops": 0,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
