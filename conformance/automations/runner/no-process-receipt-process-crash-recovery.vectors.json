  "cases": [
    {
      "caseId": "no-retry-killed-after-receipt",
      "scene": "no_retry",
      "boundary": "after_receipt",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-receipt-crash",
        "name": "Conformance no-process receipt crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 30,
        "runtime": "coven-code",
        "prompt": "Run the native no-process receipt crash conformance probe.",
        "cwd": "/work/project"
      },
      "expected": {
        "initialOutcome": "terminated",
        "launchAfterExit": "launching",
        "receiptAfterExit": true,
        "launchAfterRestart": "owned",
        "restartLaunches": 1,
        "launchAfterRetryPass": "owned",
        "launchAfterSettlePass": "succeeded",
        "claims": 2,
        "launches": 1,
        "stops": 0,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
