  "cases": [
    {
      "caseId": "prompt-restart-tick-killed-after-plan",
      "scene": "prompt",
      "boundary": "after_plan",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-tick-crash",
        "name": "Conformance tick crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 30,
        "runtime": "coven-code",
        "prompt": "Run the native tick crash conformance probe.",
        "cwd": "/work/project"
      },
      "expected": {
        "initialOutcome": "terminated",
        "slotAfterExit": "absent",
        "cursorAfterExit": 0,
        "slotAfterRestart": "owned",
        "nextSlotAfterRestart": "absent",
        "claims": 1,
        "restartLaunches": 1,
        "slotAfterPass": "succeeded",
        "nextSlotAfterPass": "absent",
        "launches": 1,
        "stops": 0,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
