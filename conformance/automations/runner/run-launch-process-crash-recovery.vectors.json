{
  "schemaVersion": "coven.automations.run-launch-process-crash-recovery-vectors.v1",
  "cases": [
    {
      "caseId": "launch-killed-after-session-insert",
      "boundary": "after_session",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-launch-crash",
        "name": "Conformance launch crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 30,
        "runtime": "coven-code",
        "prompt": "Run the native launch crash conformance probe.",
        "cwd": "/work/project"
      },
      "expected": {
        "initialOutcome": "terminated",
        "launchAfterExit": "claimed",
        "restartLaunches": 1,
        "launchAfterRestart": "owned",
        "launchAfterPass": "succeeded",
        "finalLaunch": "succeeded",
        "finalSessions": 1,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
