{
  "schemaVersion": "coven.automations.attempt-retry-process-crash-recovery-vectors.v1",
  "cases": [
    {
      "caseId": "retry-killed-after-attempt-insert",
      "boundary": "after_attempt",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-retry-crash",
        "name": "Conformance retry crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 30,
        "runtime": "coven-code",
        "prompt": "Run the native retry crash conformance probe.",
        "cwd": "/work/project"
      },
      "expected": {
        "initialOutcome": "terminated",
        "retryAfterExit": "held",
        "restartLaunches": 0,
        "retryAfterRestart": "held",
        "reissue": "committed",
        "retryAfterReissue": "retried",
        "launches": 1,
        "finalRetry": "succeeded",
        "finalSessions": 2,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
