        "byHour": [9],
        "byDay": ["MO"]
      }
    },
    {
      "caseId": "weekly-day-normalization",
      "scenario": "weekly_day_normalization",
      "rrule": "freq=weekly;byday=wed,MO,fr;byhour=8",
      "expected": {
        "outcome": "accepted",
        "frequency": "weekly",
        "byHour": [8],
        "byDay": ["FR", "MO", "WE"]
      }
    },
