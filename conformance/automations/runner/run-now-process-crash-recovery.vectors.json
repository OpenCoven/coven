      "definition": {
        "schemaVersion": 1,
        "id": "conformance-run-now-crash",
        "name": "Conformance run-now crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=21",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 30,
        "runtime": "coven-code",
        "prompt": "Run the native run-now crash conformance probe.",
        "cwd": "/work/project"
      },
      "expected": {
        "initialOutcome": "terminated",
        "launchAfterExit": "absent",
        "storedAfterExit": "none",
