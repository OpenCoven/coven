        "launchAfterReissue": "owned",
        "launchAfterPass": "succeeded",
        "launchAfterDeadline": "succeeded",
        "launchAfterLease": "succeeded",
        "resend": "replayed",
        "launches": 1,
        "stops": 0,
        "integrityOk": true,
        "replayIsNoop": true
      }
