{
  "schemaVersion": "coven.automations.retry-timeout-process-crash-recovery-vectors.v1",
  "cases": [
    {
      "caseId": "retry-timeout-killed-while-retry-waits",
      "boundary": "after_retry_commit",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-retry-timeout-crash",
        "name": "Conformance retry timeout crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 1,
        "runtime": "coven-code",
        "prompt": "Run the native retry timeout crash conformance probe.",
        "cwd": "/work/project",
        "retry": {
          "maxAttempts": 2,
          "backoffPolicy": "fixed",
          "backoffSeconds": 120,
          "retryableClasses": [
            "runtime_unavailable"
          ]
        }
      },
      "expected": {
        "initialOutcome": "terminated",
        "retryAfterExit": "scheduled",
        "retryAfterRestart": "timed_out",
        "restartIsNoop": false,
        "retryAfterPass": "timed_out",
        "passIsNoop": true,
        "launches": 0,
        "stops": 0,
        "integrityOk": true
      }
    },
