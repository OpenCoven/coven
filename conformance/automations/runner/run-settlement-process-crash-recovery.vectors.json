{
  "schemaVersion": "coven.automations.run-settlement-process-crash-recovery-vectors.v1",
  "cases": [
    {
      "caseId": "killed-after-occurrence-settled",
      "boundary": "after_occurrence",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-settlement-crash",
        "name": "Conformance settlement crash",
        "status": "PAUSED",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 30,
        "runtime": "coven-code",
        "prompt": "Run the native settlement crash conformance probe.",
        "cwd": "/work/project",
        "outputTarget": {
          "kind": "main-session"
        }
      },
      "expected": {
        "initialOutcome": "terminated",
        "settlementAfterExit": "unsettled",
        "recoverySettled": 1,
        "finalSettlement": "settled",
        "finalDelivery": "delivered",
        "finalNotices": 1,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
