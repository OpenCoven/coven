{
  "schemaVersion": "coven.automations.waiting-retry-cancellation-process-crash-recovery-vectors.v1",
  "cases": [
    {
      "caseId": "retry-cancel-killed-after-retry-cancelled",
      "boundary": "after_retry_cancelled",
      "definition": {
        "schemaVersion": 1,
        "id": "conformance-retry-cancel-crash",
        "name": "Conformance waiting retry cancellation crash",
        "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9",
        "timezone": "utc",
        "misfire": "latest",
        "overlap": "forbid",
        "timeoutMinutes": 1,
        "runtime": "coven-code",
        "prompt": "Run the native waiting retry cancellation crash conformance probe.",
        "cwd": "/work/project",
        "retry": {
          "maxAttempts": 2,
          "backoffPolicy": "fixed",
          "backoffSeconds": 120,
          "retryableClasses": [
            "runtime_unavailable"
          ]
        }
      },
      "expected": {
        "initialOutcome": "terminated",
        "retryAfterExit": "scheduled",
        "storedAfterExit": "none",
        "retryAfterRestart": "scheduled",
        "storedAfterRestart": "none",
        "restartIsNoop": true,
        "reissue": "withdrawn",
        "retryAfterReissue": "cancelled",
        "storedAfterReissue": "withdrawn",
        "passIsNoop": true,
        "resend": "replayed",
        "launches": 0,
        "stops": 0,
        "integrityOk": true,
        "replayIsNoop": true
      }
    },
