{
  "vectorId": "golden.21-retention-redaction-receipt-verify",
  "vectorVersion": 1,
  "profile": "privacy",
  "category": "scenario",
  "title": "Golden 21: retention and redaction without broken receipt verification",
  "deterministic": true,
  "artifacts": ["coven.automations.receipt.v1", "diagnostics.doctor.v1"],
  "specRefs": ["coven#858"],
  "virtualTime": { "start": "2026-03-01T00:00:00.000Z" },
  "input": {
    "definitions": [
      {
        "schemaVersion": 1, "id": "routine", "name": "Routine", "status": "ACTIVE",
        "rrule": "FREQ=DAILY;BYHOUR=9", "timezone": "utc", "misfire": "latest", "overlap": "forbid",
        "timeoutMinutes": 30, "runtime": "coven-code", "cwd": "work/proj",
        "prompt": "Draft the reply from the private journal."
      }
    ],
    "operations": [
      { "op": "setRetention", "window": "3600s" },
      { "op": "tick", "at": "2026-03-01T10:00:00.000Z" },
      { "op": "erase", "automationId": "routine", "at": "2026-03-01T11:00:00.000Z" },
      { "op": "redactReceipts" },
      { "op": "verifyReceipts" }
    ]
  },
  "expected": {
    "receipts": { "count": 1, "allVerify": true, "verifyAfterRedaction": true },
    "redaction": {
      "forbiddenSubstrings": ["private journal"]
    }
  }
}
