{
  "name": "@opencoven/coven",
  "version": "2026.4.28",
  "description": "OpenClaw ACP runtime bridge for local Coven daemon sessions.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenCoven/coven.git",
    "directory": "packages/openclaw-coven"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "coven",
    "acp",
    "agent-runtime"
  ],
  "files": [
    "assets",
    "README.md",
    "tsconfig.json",
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.4.26"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "minHostVersion": ">=2026.4.26"
    },
    "compat": {
      "pluginApi": ">=2026.4.25"
    },
    "build": {
      "openclawVersion": "2026.6.5"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
