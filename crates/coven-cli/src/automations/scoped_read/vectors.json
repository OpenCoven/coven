{
  "profile": "coven.automations.scoped-read.vectors.v1",
  "about": "Exact-file reads under the scoped read service (coven#857). Paths and grants are lexical; filesystem cases build a tree under a scratch directory with sibling folders root/ and outside/, bind root/ as the project root, and may change the tree at one step of the read. Every outside or protected file holds the word SENTINEL, and no successful read may return it. In the requests and filesystem sections a scope is written `<access>:<path>` for a non-recursive project scope, with a `recursive-` or `workspace-` prefix for the other forms; a filesystem request is a project path unless `requestRoot` says otherwise. An expectation with `filesystem: false` must refuse before any filesystem access, and one with `lastStep` must stop at that step of the read, so a refusal named as happening before an open really does.",
  "paths": [
    { "id": "plain-file", "path": "notes/today.md", "expect": "ok" },
    { "id": "top-level-file", "path": "README.md", "expect": "ok" },
    { "id": "unicode-name", "path": "caf\u00e9/men\u00fc.md", "expect": "ok" },
    { "id": "multi-byte-near-byte-three", "path": "a\u20acx", "expect": "ok" },
    { "id": "com-without-digit", "path": "COMx.md", "expect": "ok" },
    { "id": "dots-inside-a-name", "path": "notes/v1.2.md", "expect": "ok" },
    { "id": "empty", "path": "", "expect": "path_encoding_unsupported" },
    { "id": "absolute", "path": "/etc/hosts", "expect": "path_absolute" },
    { "id": "drive-absolute", "path": "C:/Windows/win.ini", "expect": "path_absolute" },
    { "id": "drive-relative", "path": "C:notes.md", "expect": "path_absolute" },
    { "id": "parent", "path": "..", "expect": "path_traversal" },
    { "id": "parent-first", "path": "../outside/secret.txt", "expect": "path_traversal" },
    { "id": "parent-inside", "path": "notes/../../outside/secret.txt", "expect": "path_traversal" },
    { "id": "backslash-separator", "path": "notes\\today.md", "expect": "path_encoding_unsupported" },
    { "id": "backslash-traversal", "path": "..\\outside\\secret.txt", "expect": "path_encoding_unsupported" },
    { "id": "repeated-separator", "path": "notes//today.md", "expect": "path_encoding_unsupported" },
    { "id": "trailing-separator", "path": "notes/", "expect": "path_encoding_unsupported" },
    { "id": "dot-component", "path": "./notes/today.md", "expect": "path_encoding_unsupported" },
    { "id": "dot-inside", "path": "notes/./today.md", "expect": "path_encoding_unsupported" },
    { "id": "embedded-nul", "path": "notes/today.md\u0000.txt", "expect": "path_encoding_unsupported" },
    { "id": "control-character", "path": "notes/to\u0007day.md", "expect": "path_encoding_unsupported" },
    { "id": "newline", "path": "notes/today.md\nsecret", "expect": "path_encoding_unsupported" },
    { "id": "alternate-data-stream", "path": "notes/today.md:secret", "expect": "path_encoding_unsupported" },
    { "id": "trailing-dot", "path": "notes/today.md.", "expect": "path_encoding_unsupported" },
    { "id": "trailing-space", "path": "notes/today.md ", "expect": "path_encoding_unsupported" },
    { "id": "device-con", "path": "CON", "expect": "path_encoding_unsupported" },
    { "id": "device-lowercase-with-extension", "path": "notes/nul.txt", "expect": "path_encoding_unsupported" },
    { "id": "device-com", "path": "COM1", "expect": "path_encoding_unsupported" },
    { "id": "device-com-superscript", "path": "com\u00b9.log", "expect": "path_encoding_unsupported" },
    { "id": "device-lpt", "path": "logs/LPT9.log", "expect": "path_encoding_unsupported" },
    { "id": "device-conin", "path": "CONIN$", "expect": "path_encoding_unsupported" }
  ],
  "grants": [
    { "id": "exact-file", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/today.md", "access": "read", "recursive": false }], "expect": "ok" },
    { "id": "recursive-directory", "scopes": [{ "kind": "filesystem", "root": "project", "path": "docs/guides", "access": "read", "recursive": true }], "expect": "ok" },
    { "id": "write-only", "scopes": [{ "kind": "filesystem", "root": "workspace", "path": "out/report.md", "access": "write", "recursive": false }], "expect": "ok" },
    { "id": "non-filesystem-kinds-are-ignored", "scopes": [{ "kind": "network", "scheme": "https", "host": "example.com", "port": 443, "path_prefix": "/api", "methods": ["GET"] }], "expect": "ok" },
    { "id": "no-scopes", "scopes": [], "expect": "ok" },
    { "id": "unknown-kind", "scopes": [{ "kind": "process", "path": "bin/sh" }], "expect": "grant_unsupported" },
    { "id": "not-an-object", "scopes": ["notes/today.md"], "expect": "grant_unsupported" },
    { "id": "missing-field", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/today.md", "access": "read" }], "expect": "grant_unsupported" },
    { "id": "extra-field", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/today.md", "access": "read", "recursive": false, "follow": true }], "expect": "grant_unsupported" },
    { "id": "unknown-root", "scopes": [{ "kind": "filesystem", "root": "home", "path": "notes/today.md", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "unknown-access", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/today.md", "access": "execute", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "recursive-not-boolean", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/today.md", "access": "read", "recursive": "false" }], "expect": "grant_unsupported" },
    { "id": "root-wide", "scopes": [{ "kind": "filesystem", "root": "project", "path": ".", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "shallow-recursive", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes", "access": "read", "recursive": true }], "expect": "grant_unsupported" },
    { "id": "wildcard", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/*.md", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "double-dot-inside-a-name", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/a..b.md", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "backslash-path", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes\\today.md", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "repeated-separator-path", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes//today.md", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "dot-component-path", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/./today.md", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "trailing-separator-path", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/", "access": "read", "recursive": false }], "expect": "grant_unsupported" },
    { "id": "one-bad-scope-refuses-the-grant", "scopes": [{ "kind": "filesystem", "root": "project", "path": "notes/today.md", "access": "read", "recursive": false }, { "kind": "filesystem", "root": "project", "path": "/etc/hosts", "access": "read", "recursive": false }], "expect": "grant_unsupported" }
  ],
  "requests": [
    { "id": "exact-match", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "notes/today.md" }, "expect": "authorized" },
    { "id": "read-and-write-scopes", "scopes": ["write:notes/today.md", "read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "notes/today.md" }, "expect": "authorized" },
    { "id": "sibling", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "notes/tomorrow.md" }, "expect": "scope_missing" },
    { "id": "parent-directory", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "notes" }, "expect": "scope_missing" },
    { "id": "child-of-a-file-grant", "scopes": ["read:notes"], "request": { "operation": "read_file", "root": "project", "path": "notes/today.md" }, "expect": "scope_missing" },
    { "id": "other-root", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "workspace", "path": "notes/today.md" }, "expect": "scope_missing" },
    { "id": "case-alias", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "Notes/today.md" }, "expect": "scope_missing" },
    { "id": "unicode-alias", "scopes": ["read:caf\u00e9/menu.md"], "request": { "operation": "read_file", "root": "project", "path": "cafe\u0301/menu.md" }, "expect": "scope_missing" },
    { "id": "write-does-not-imply-read", "scopes": ["write:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "notes/today.md" }, "expect": "scope_access_denied" },
    { "id": "beneath-a-recursive-scope", "scopes": ["recursive-read:docs/guides"], "request": { "operation": "read_file", "root": "project", "path": "docs/guides/setup.md" }, "expect": "operation_unmapped" },
    { "id": "the-recursive-scope-itself", "scopes": ["recursive-read:docs/guides"], "request": { "operation": "read_file", "root": "project", "path": "docs/guides" }, "expect": "operation_unmapped" },
    { "id": "beside-a-recursive-scope", "scopes": ["recursive-read:docs/guides"], "request": { "operation": "read_file", "root": "project", "path": "docs/guides-old/setup.md" }, "expect": "scope_missing" },
    { "id": "no-scopes", "scopes": [], "request": { "operation": "read_file", "root": "project", "path": "notes/today.md" }, "expect": "scope_missing" },
    { "id": "listing", "scopes": ["read:notes/today.md"], "request": { "operation": "list_directory", "root": "project", "path": "notes" }, "expect": "operation_unmapped" },
    { "id": "search", "scopes": ["read:notes/today.md"], "request": { "operation": "search", "root": "project", "path": "notes", "pattern": "todo" }, "expect": "operation_unmapped" },
    { "id": "unknown-operation", "scopes": ["read:notes/today.md"], "request": { "operation": "write_file", "root": "project", "path": "notes/today.md" }, "expect": "request_invalid" },
    { "id": "missing-operation", "scopes": ["read:notes/today.md"], "request": { "root": "project", "path": "notes/today.md" }, "expect": "request_invalid" },
    { "id": "extra-field", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "notes/today.md", "grant": "everything" }, "expect": "request_invalid" },
    { "id": "missing-path", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project" }, "expect": "request_invalid" },
    { "id": "path-not-a-string", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": ["notes", "today.md"] }, "expect": "request_invalid" },
    { "id": "unknown-root", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "home", "path": "notes/today.md" }, "expect": "request_invalid" },
    { "id": "not-an-object", "scopes": ["read:notes/today.md"], "request": "notes/today.md", "expect": "request_invalid" },
    { "id": "traversal-is-refused-before-the-scope", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "notes/../notes/today.md" }, "expect": "path_traversal" },
    { "id": "absolute", "scopes": ["read:notes/today.md"], "request": { "operation": "read_file", "root": "project", "path": "/etc/hosts" }, "expect": "path_absolute" }
  ],
  "filesystem": [
    {
      "id": "exact-file-is-read",
      "tree": [{ "file": "root/notes/today.md", "text": "granted notes" }, { "file": "root/notes/other.md", "text": "not granted" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "text": "granted notes", "lastStep": "read" }
    },
    {
      "id": "top-level-file-is-read",
      "tree": [{ "file": "root/README.md", "text": "readme" }],
      "scopes": ["read:README.md"],
      "request": "README.md",
      "expect": { "text": "readme", "lastStep": "read" }
    },
    {
      "id": "empty-file-is-read",
      "tree": [{ "file": "root/notes/empty.md", "text": "" }],
      "scopes": ["read:notes/empty.md"],
      "request": "notes/empty.md",
      "expect": { "text": "" }
    },
    {
      "id": "sibling-is-refused-without-access",
      "tree": [{ "file": "root/notes/today.md", "text": "granted notes" }, { "file": "root/notes/other.md", "text": "SENTINEL" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/other.md",
      "expect": { "refusal": "scope_missing", "filesystem": false }
    },
    {
      "id": "traversal-is-refused-without-access",
      "tree": [{ "file": "root/notes/today.md", "text": "granted notes" }, { "file": "outside/secret.txt", "text": "SENTINEL" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/../../outside/secret.txt",
      "expect": { "refusal": "path_traversal", "filesystem": false }
    },
    {
      "id": "write-scope-is-refused-without-access",
      "tree": [{ "file": "root/notes/today.md", "text": "SENTINEL" }],
      "scopes": ["write:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "scope_access_denied", "filesystem": false }
    },
    {
      "id": "recursive-scope-is-refused-without-access",
      "tree": [{ "file": "root/docs/guides/setup.md", "text": "SENTINEL" }],
      "scopes": ["recursive-read:docs/guides"],
      "request": "docs/guides/setup.md",
      "expect": { "refusal": "operation_unmapped", "filesystem": false }
    },
    {
      "id": "unbound-root-is-refused-without-access",
      "tree": [{ "file": "root/notes/today.md", "text": "SENTINEL" }],
      "scopes": ["workspace-read:notes/today.md"],
      "request": "notes/today.md",
      "requestRoot": "workspace",
      "expect": { "refusal": "root_unbound", "filesystem": false }
    },
    {
      "id": "missing-file",
      "tree": [{ "dir": "root/notes" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_not_found", "lastStep": "directory:0" }
    },
    {
      "id": "file-where-a-directory-is-expected",
      "tree": [{ "file": "root/notes", "text": "not a directory" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_not_found", "lastStep": "root" }
    },
    {
      "id": "directory-under-a-file-scope",
      "tree": [{ "file": "root/notes/today.md", "text": "SENTINEL" }],
