      "request": ".claude/settings.json",
      "expect": { "refusal": "resource_protected", "lastStep": "root" }
    },
    {
      "id": "protected-file",
      "tree": [{ "file": "root/notes/today.md", "text": "SENTINEL" }],
      "protected": ["root/notes/today.md"],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_protected", "lastStep": "directory:0" }
    },
    {
      "id": "protected-directory-by-case-alias",
      "tree": [{ "file": "root/.claude/settings.json", "text": "SENTINEL" }],
      "protected": ["root/.claude"],
      "scopes": ["read:.CLAUDE/settings.json"],
      "request": ".CLAUDE/settings.json",
      "alias": "case",
      "expect": { "refusal": "resource_protected" }
    },
    {
      "id": "protected-directory-by-unicode-alias",
      "tree": [{ "file": "root/caf\u00e9/settings.json", "text": "SENTINEL" }],
      "protected": ["root/caf\u00e9"],
      "scopes": ["read:cafe\u0301/settings.json"],
      "request": "cafe\u0301/settings.json",
      "alias": "unicode",
      "expect": { "refusal": "resource_protected" }
    },
    {
      "id": "root-is-protected",
      "tree": [{ "file": "root/notes/today.md", "text": "SENTINEL" }],
      "protected": ["root"],
