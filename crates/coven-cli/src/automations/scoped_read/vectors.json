      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "race": { "at": "before_directory:0", "do": [{ "rename": ["root/notes", "root/notes-old"] }, { "symlink": "root/notes", "target": "../outside" }] },
      "expect": { "refusal": "resource_symlink" }
    },
    {
      "id": "directory-replaced-by-another-before-its-open",
      "tree": [{ "file": "root/notes/today.md", "text": "granted notes" }, { "file": "outside/stash/today.md", "text": "SENTINEL" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "race": { "at": "before_directory:0", "do": [{ "rename": ["root/notes", "root/notes-old"] }, { "rename": ["outside/stash", "root/notes"] }] },
      "expect": { "refusal": "resource_moved" }
    },
    {
      "id": "directory-renamed-out-after-its-open",
