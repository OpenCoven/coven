      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "race": { "at": "directory:0", "do": [{ "rename": ["root/notes", "outside/notes"] }] },
      "expect": { "refusal": "resource_moved" }
    },
    {
      "id": "directory-swapped-after-its-open",
      "tree": [{ "file": "root/notes/today.md", "text": "granted notes" }, { "file": "outside/stash/today.md", "text": "SENTINEL" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "race": { "at": "directory:0", "do": [{ "rename": ["root/notes", "root/notes-old"] }, { "rename": ["outside/stash", "root/notes"] }] },
      "expect": { "refusal": "resource_moved" }
