      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_multiply_linked", "lastStep": "directory:0" }
    },
    {
      "id": "hard-link-inside-the-root",
      "tree": [{ "file": "root/notes/real.md", "text": "SENTINEL" }, { "hardlink": "root/notes/today.md", "target": "root/notes/real.md" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_multiply_linked", "lastStep": "directory:0" }
    },
    {
      "id": "fifo",
      "tree": [{ "dir": "root/notes" }, { "fifo": "root/notes/today.md" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_special", "lastStep": "directory:0" }
    },
    {
      "id": "socket",
      "tree": [{ "dir": "root/notes" }, { "socket": "root/notes/today.md" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_special", "lastStep": "directory:0" }
    },
    {
      "id": "protected-directory",
      "tree": [{ "file": "root/.claude/settings.json", "text": "SENTINEL" }],
      "protected": ["root/.claude"],
