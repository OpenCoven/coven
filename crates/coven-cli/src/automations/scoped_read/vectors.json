      "expect": { "refusal": "resource_directory", "lastStep": "root" }
    },
    {
      "id": "file-symlink-to-outside",
      "tree": [{ "file": "outside/secret.txt", "text": "SENTINEL" }, { "symlink": "root/notes/today.md", "target": "../../outside/secret.txt" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_symlink", "lastStep": "directory:0" }
    },
    {
      "id": "file-symlink-inside-the-root",
      "tree": [{ "file": "root/notes/real.md", "text": "SENTINEL" }, { "symlink": "root/notes/today.md", "target": "real.md" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_symlink", "lastStep": "directory:0" }
    },
    {
      "id": "directory-symlink-to-outside",
      "tree": [{ "file": "outside/today.md", "text": "SENTINEL" }, { "symlink": "root/notes", "target": "../outside" }],
      "scopes": ["read:notes/today.md"],
      "request": "notes/today.md",
      "expect": { "refusal": "resource_symlink", "lastStep": "root" }
    },
    {
