# Session-policy fixtures are digest-pinned wire contracts.
spec/coven-session-policy/v1/fixtures/*.json text eol=lf
spec/coven-session-policy/v2/fixtures/*.json text eol=lf

# Release store dumps are loaded byte for byte by the upgrade tests.
crates/coven-cli/tests/fixtures/automations-release-stores/*.sql text eol=lf

